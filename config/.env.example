# 伝書鳩の実 ID はローカルで設定する
GROKWATCH_AGENT_ID=YOUR_AGENT_ID
GROKWATCH_AGENT_NAME=伝書鳩
GROKWATCH_DEVICE_TOKEN=
GROKWATCH_GATEWAY_PORT=8765

# webhook / realtime / gbot_cli / mock から一つを選ぶ（realtime は v1.2.0）
GROKWATCH_BRIDGE=webhook
# webhook の URL と送信キーは macOS Keychain での管理を推奨
GROKWATCH_WEBHOOK_URL=
GROKWATCH_REPLY_LISTEN=127.0.0.1:8767

# 「Hi Grok」ウェイクワード（v1.1.0）。1 で有効。既定は無効
GROKWATCH_WAKE=0
# 任意: ウェイク判定用の whisper モデル（省略時は GROKWATCH_WHISPER_MODEL）
GROKWATCH_WAKE_MODEL=

# OpenAI Realtime（v1.2.0、GROKWATCH_BRIDGE=realtime のとき）
# API キー（GROKWATCH_OPENAI_API_KEY）と作業受付の URL・キー（GROKWATCH_TASK_WEBHOOK_URL / _KEY）は
# macOS Keychain に保存する（deploy/macos/set-realtime-keys.sh）。ここには書かない
GROKWATCH_REALTIME_MODEL=
GROKWATCH_REALTIME_VOICE=
GROKWATCH_SEARCH_MODEL=
# 予定・メールを読む補助コマンド（install.sh が配置し、LaunchAgent に渡す）
GROKWATCH_CONTEXT_BIN=
