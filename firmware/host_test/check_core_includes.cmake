cmake_minimum_required(VERSION 3.16)
file(GLOB_RECURSE sources "${CORE}/*.cpp" "${CORE}/*.hpp")
if(NOT sources)
    message(FATAL_ERROR "No core sources")
endif()
set(standard algorithm array charconv cmath cstddef cstdint limits optional random string string_view utility variant vector)
foreach(source IN LISTS sources)
    file(STRINGS "${source}" includes REGEX "^[ \t]*#[ \t]*include")
    foreach(line IN LISTS includes)
        if(line MATCHES "^[ \t]*#[ \t]*include[ \t]*\"grokwatch/([a-z_]+\\.hpp)\"[ \t]*$")
            if(EXISTS "${CORE}/include/grokwatch/${CMAKE_MATCH_1}")
                continue()
            endif()
        elseif(line MATCHES "^[ \t]*#[ \t]*include[ \t]*<([a-z_]+)>[ \t]*$")
            if(CMAKE_MATCH_1 IN_LIST standard)
                continue()
            endif()
        endif()
        message(FATAL_ERROR "${source}: unexpected include ${line}")
    endforeach()
endforeach()
