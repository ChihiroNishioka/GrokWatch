menu "GrokWatch"

config GROKWATCH_WIFI_SSID
    string "Wi-Fi SSID"
    default ""

config GROKWATCH_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""

config GROKWATCH_GATEWAY_HOST
    string "Gateway host"
    default ""

config GROKWATCH_GATEWAY_PORT
    int "Gateway port"
    range 1 65535
    default 8765

config GROKWATCH_DEVICE_TOKEN
    string "Device token"
    default ""

config GROKWATCH_WAKE_WORD
    bool "Enable Hi Grok wake word (requires gateway support)"
    default y

endmenu
